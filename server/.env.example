# Server Configuration
PORT=4000
NODE_ENV=development

# CORS Configuration
CLIENT_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration (REQUIRED - Generate secure random strings for production!)
JWT_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string

# Database Configuration (Optional - currently using mock database)
# DATABASE_URL=postgresql://user:password@localhost:5432/livedisplay?schema=public

# Logging
LOG_LEVEL=info

# Display Access (Optional - comma-separated list of allowed origins for display endpoint)
DISPLAY_ALLOWED_ORIGINS=http://localhost:5173

# Email Configuration (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Production Configuration
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-production-domain.com
# JWT_SECRET=use-a-very-secure-random-string-here
# LOG_LEVEL=warn
